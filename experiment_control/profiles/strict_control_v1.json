{
  "schema_version": 1,
  "profile_id": "strict_control_v1",
  "purpose": "相同主干、训练预算和采样设置下比较基线版与梯度版",
  "training": {
    "encoding": "Fourier",
    "num_layers": 3,
    "hidden_dim": 128,
    "density_scale": 1,
    "iterations": 30000,
    "learning_rate": 0.005,
    "num_rays": 256,
    "max_steps": 256,
    "seed": 0,
    "bound": 2.0,
    "scale": 0.00054421,
    "dt_gamma": 0.0,
    "checkpoint": "scratch",
    "fp16": true,
    "cuda_ray": true,
    "maskflag": true
  },
  "evaluation_grid": {
    "roi_size": [0.9523675, 1.99997175, 0.9523675],
    "roi_num": [140, 294, 140],
    "roi_voxel_size": 0.01360525,
    "valbound": [-1.0, 3.0]
  },
  "nominal_budget": {
    "total_rays": 7680000,
    "max_ray_samples": 1966080000
  },
  "resume_policy": {
    "initial_launch": "scratch",
    "allowed_scope": "same batch and same route only",
    "full_checkpoint_pattern": "ngp_epXXXX.pth",
    "resume_preserves_declared_total_iterations": true
  },
  "extension_policy": {
    "mode": "cosine_restart_over_remaining_iterations",
    "child_batch_required": true,
    "restart_learning_rate_source": "training.learning_rate",
    "eta_min": 0.000001,
    "parent_batch_is_immutable": true
  }
